# autoMIL Configuration
# This file configures autoMIL for your project.
# Edit the paths and settings below for your environment.

project:
  name: "{{ project_name }}"
  description: "TODO: Describe your task"

task:
  name: "{{ project_name }}"
  type: "{{ task_type }}"
  num_classes: 2
  label_column: "label"
  positive_label: 1

data:
  features_dir: "/path/to/features/"
  splits_dir: "/path/to/splits/"
  mapping_csv: "/path/to/mapping.csv"
  num_folds: 5
  seed: 42

encoders:
  primary: "{{ encoder }}"
  available:
    # TODO: Set correct dimension for your encoder
    {{ encoder }}: 1536

baseline:
  model: "clam_mb"
  framework: "CLAM"
  val_auc: 0.0
  composite: 0.0

metrics:
  primary: "composite"
  composite_formula: "(val_auc + val_bacc) / 2"
  track: ["val_auc", "val_bacc"]

training:
  learning_rate: 3e-4
  weight_decay: 1e-4
  dropout: 0.25
  num_epochs: 100
  warmup_epochs: 5
  patience: 10
  batch_size: 32
  max_seq_length: 4096
  fold_count: 5                   # K-fold CV. sklearn-iris demo would set 1; PathBench-MIL uses 5x5

files:
  # The agent scopes the codebase and determines what to edit.
  # These lists guide the agent and control automil submit auto-detect.
  editable: []       # TODO: list files the agent may modify
  readonly: []       # TODO: list files the agent should not modify

run:
  script: "train.py"              # training script name (relative to project root)
  command: null                   # optional: full command override (e.g., "python src/train.py --config config.yaml")
  mil_model: "default"            # budget-cell key (D-12): `automil submit` resolves --mil-model from here,
                                  # so submits work without the flag. Single-model projects can leave this;
                                  # multi-model projects pass `--mil-model <name>` per submit (it overrides)
                                  # so each model gets its own budget cell.

orchestrator:
  poll_interval_sec: 5
  safety_margin_gb: 2.0
  default_timeout_min: 150
  # CFG-2: these are the ONLY copies. They used to be declared here as literals
  # AND again under `cap:` as the Jinja expressions `automil init`'s hardware
  # healthcheck fills in — but the daemon reads `orchestrator:`
  # (_orchestrator_daemon.py:439-444), so the measured values landed in a dead
  # block and these literals were what ran. Fallbacks stay conservative, so a
  # project with no healthcheck data is unchanged.
  max_concurrent_per_gpu: {{ max_concurrent_per_gpu | default(1) }}
  default_vram_estimate_gb: {{ default_vram_estimate_gb | default(0.5) }}
  scheduling_policy: "best_fit"   # best_fit | round_robin | least_loaded

viz:
  port: 8420
  # Default 127.0.0.1: dashboard only reachable from the host machine.
  # Set to "0.0.0.0" if you need to view it from another host on a trusted
  # network. The SSE stream has no auth and surfaces PIDs, GPU utilization,
  # and node descriptions.
  host: "127.0.0.1"

# --- Registry (Phase 1, REG-04 / REG-06 / REG-07) ---
registry:
  # Glob patterns the agent's overlay MUST NOT touch. Empty = no protection.
  # Add the shared library files / training-script entry points that should
  # only change via committed variant modules. Examples:
  #   - "lib/CLAM/**"
  #   - "src/models/clam/base.py"
  # NOTE: autoMIL ships no defaults here. Only YOU know which files are
  # load-bearing for your project (D-33).
  protected: []

  # Search-scope mode: "free" (default, F2-aligned) or "architecture-preserving"
  # ("free" runs interface + purity validators; "architecture-preserving"
  # additionally runs identity-strict validation per identity_constraints.)
  mode: "free"

  # Command and registered-variant channels admitted in architecture-preserving
  # mode. Keep empty unless the consumer has executable adapters for them.
  allowed_override_options: []
  allowed_variant_kinds: []

  # Scalar keys that would erase a defining method mechanism when changed.
  # The submit/launch policy rejects these inside --hparams.
  identity_locked_hparams: []

  # Reproduction tolerance for `automil verify-repro <node_id>` (default ±0.005).
  repro_tolerance: 0.005

  # Per-project identity constraints (used in architecture-preserving mode).
  # Examples: "param_count_pct: 5"  ("variant param count within 5% of parent")
  # Empty list disables structural identity checks beyond default dtype/rank.
  identity_constraints: []

# --- Environment passthrough (D-87, TRJ-04) and required vars (DEC-05 / D-202) ---
# `required` lists vars that MUST be set before experiments run; `automil check`
# fails with "Missing required env var: <name>" if any are unset.  Empty by
# default (generic consumers like sklearn-iris need no env vars).
#
# `passthrough` lists vars forwarded from the orchestrator process into each
# experiment subprocess.  AUTOMIL_RUNTIME must be here so the trajectory
# recorder inside the experiment sees the declared runtime value.
#
# Migration note for autobench-shaped consumers: see CHANGELOG.md 8.0.0
# BREAKING section for the recommended `required` + `passthrough` lists.
env:
  required: []

  passthrough:
    - AUTOMIL_*       # All automil framework variables (includes AUTOMIL_RUNTIME)
    - AUTOMIL_RUNTIME # Runtime declaration: explicit, never inferred (D-87)

  # Additional .env files to load (paths relative to project_root). The
  # orchestrator always loads `.env` at the project root; entries here are
  # additive. First-write-wins, and the shell environment overrides both.
  # Use this when the project keeps environment variables in a subdirectory
  # (e.g. a consumer package with its own `.env`). Example:
  #   dotenv_files:
  #     - "configs/.env.local"
  dotenv_files: []

# --- Composite scoring (DEC-04 / D-200 / CR-1b) ---
# scoring.formula is the reducer the framework uses to recompute the composite
# from the validation `metrics` block at ingest (CR-1b: the val-firewall does
# not trust the reported scalar). Valid values:
#   formula: ""                # default -> "mean" over metrics values; this
#                              #   reproduces (val_auc + val_bacc) / 2 and a
#                              #   lone val_c_index exactly
#   formula: "mean" | "max" | "min"
#   formula: "trust_reported"  # explicit opt-out; weakens the val-firewall
# Anything else (e.g. an arithmetic expression) fails `automil check` and graph
# seeding — it is NOT evaluated. Document the human-readable recipe in a
# comment or in metrics.composite_formula (informational) instead.
#
# scoring.technique_map is a {pattern: tag} dict for description-driven
# auto-tagging. When `automil submit` / `automil propose` is called WITHOUT
# --techniques, the framework greps the description (case-insensitive
# substring) for each `pattern` and appends `tag` to `node['techniques']`.
# Empty default = framework ships no domain vocabulary (autoMIL is generic).
# Populate this for your consumer's shorthand:
#
#   technique_map:
#     focal:    focal_loss
#     rdrop:    rdrop
#     uni_v2:   uni_v2
#
# Used by graph.recalculate_scores' novelty term and by the viz "Techniques"
# tab. Explicit --techniques on submit/propose still wins over auto-extract.
scoring:
  formula: ""
  technique_map: {}
  accept_margin: 0.0   # Ladder keep-margin δ: child kept iff composite > parent + δ. Predeclare per-dataset (0.0 = strict dominance). Read from graph.json meta.scoring.
  # CR-4: the margin ACTUALLY applied is max(accept_margin, se_multiplier x the
  #   PARENT's measured cross-fold SE). The noise floor can only ever raise the
  #   bar, never lower a predeclared δ, and it is derived from the incumbent —
  #   if it came from the child, taking the argmax over screened candidates would
  #   also be taking the argmin over their margins.
  #   1.0 = one SE. 0.0 disables the noise floor and reverts to the bare δ.
  #   This is a conservative screen during search, NOT a significance test: the
  #   paired inference lives in the Stage-B gate (gate/stats.py).
  se_multiplier: 1.0

# --- Variant selection (D-35, REG-07) ---
# The framework resolves these via registry.resolve_model(parent, variant) etc.
# Set after porting your first variant via `automil port-variant <node_id>`.
model:
  variant: null    # e.g. "clam_mb_v0176"
  parent: null     # e.g. "clam_mb"
loss:
  variant: null    # e.g. "ce_smooth008"
policy:
  variant: null    # e.g. "sam_lookahead"

# Cap configuration: consumer-supplied, NOT framework-mandated.
# autoMIL is generic; these are framework fallbacks. The frozen preprint
# campaign separately pins 12h plus exactly 30 launches per cell. Durations
# accept 6h / 30m / 90s / 2d (or a bare number = seconds). Change with
# `uv run automil budget set 6h`; per-cell override via
# `uv run automil submit --budget-seconds`.
# All cap values are honored ONLY on the submit that opens a cell (D-134).
cap:
  budget: 6h               # agent-active working budget; e.g. 6h, 30m, 90s
  safety_buffer: 30m       # pre-termination warning window; must be < budget
  # eval_budget: how many experiments a cell may LAUNCH. This is the primary
  #   equal-effort axis — an evaluation count is portable across agent runtimes,
  #   whereas wall-clock is not, so a count is what another lab can reproduce.
  #   It is a SECOND AXIS, not a mode: the time budget above stays on as the
  #   safety wall, and whichever runs out first stops new work.
  #   Counted at launch, so crashed / partial / budget-killed runs all count:
  #   equal effort means equal ATTEMPTS, not equal successes (otherwise buggy
  #   code would earn unlimited free retries). Usable results are reported
  #   separately per cell as `usable` in `automil budget show`.
  #   null = no eval cap (time-only). Set an integer to enable, e.g. 40.
  eval_budget: null
  # mode: how the budget clock is metered.
  #   agent_active (default) = Claude Code's native active-time counter (CLI +
  #     user active seconds; idle excluded), scraped from Claude's localhost
  #     Prometheus endpoint. Synchronous hooks bind session to cell.
  #   wall_clock = continuous time since cell creation (counts GPU + idle time).
  mode: agent_active

hardware:
  accelerator: {{ healthcheck_accelerator | default("cpu") }}
  gpu_count: {{ healthcheck_gpu_count | default(0) }}
  min_vram_gb: {{ healthcheck_vram_gb | default(0.0) }}

# Gate configuration: consumer-supplied (NOT framework constants).
# Generalization gate (Phase 5 / GTE-01..06). K, p_threshold, bootstrap_reps
# are Leo's autoMIL-paper defaults; another consumer with a different
# statistical-power requirement supplies different values. Pre-registration
# (D-138) is enforced regardless of these values.
gate:
  auto_nominate:    false        # RESERVED (C-e): parsed + validated, but NO automatic nomination path exists — nomination is always `automil nominate` (operator-driven, D-142). Setting true changes nothing today.
  K:                2            # O-01 default: max(2, N_cells//3) generous starting K
  p_threshold:      0.05         # O-02 default: conventional alpha; Bonferroni divides
  bootstrap_reps:   1000         # GTE-04 locked: 1000 per F1 paper §4.4

# --- Backend configuration (Phase 6 / D-152..D-188) ---
# Select the job execution backend. Default "local" works on any machine.
# "slurm" requires: uv sync --extra slurm + valid directives below.
# "ray"   requires: uv sync --extra ray   + RAY_ADDRESS env var or local cluster.
backend:
  name: "local"            # "local" | "slurm" | "ray"

  slurm:
    # walltime_seconds is the framework-side cap value (D-155, RESEARCH.md OQ-1).
    # SLURMBackend converts this to submitit's timeout_min = max(1, walltime_seconds // 60).
    walltime_seconds: 21600       # 6h default; override per-campaign
    debug_in_process: false       # set true to use submitit cluster="debug" (CI/test only)
    directives:
      partition: "TODO_FILL_IN"   # required, operator-supplied; e.g. "compute"
      account: "TODO_FILL_IN"     # required, operator-supplied; e.g. "mylab"
      qos: null                   # optional, null disables; e.g. "high"
      cpus_per_task: 8            # required, integer
      mem_gb: 48                  # required, integer
      gpus_per_node: 1            # optional, defaults to 1 if omitted
      # NOTE: `signal` is framework-mandated as "B:TERM@30" (Phase 4 D-115 cap contract);
      # automil check rejects any operator override here.

  ray:
    # Hybrid init (D-161): try ray.init(address=RAY_ADDRESS or "auto"); on
    # ConnectionError fall back to local cluster IF allow_local_fallback is true.
    allow_local_fallback: true    # false → raise RayClusterUnreachableError if RAY_ADDRESS unreachable
