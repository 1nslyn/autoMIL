# AutoBench environment variables
# Copy this to .env and fill in the values for your environment.

# HuggingFace token (required for gated model downloads)
HF_TOKEN=

# Weights & Biases API key (optional, for experiment logging)
WANDB_API_KEY=

# Dataset root paths — override defaults from dataset YAML configs.
# Set these to match your HPC or workstation paths.

# Ovarian cancer dataset root
AUTOBENCH_OVARIAN_ROOT=/path/to/ovarian/dataset

# CLWD lung adenocarcinoma dataset root
AUTOBENCH_CLWD_ROOT=/path/to/clwd/dataset

# CCRCC (clear cell renal cell carcinoma) dataset root
AUTOBENCH_CCRCC_ROOT=/path/to/ccrcc/dataset

# Hancock dataset root
# AUTOBENCH_HANCOCK_ROOT=/path/to/hancock/dataset

# ============================================================
# Preprint roster (5 cohorts — the active experiment slate)
# 3 TCGA (GOLDMARK/GDC) + 2 CPTAC (Patho-Bench/GDC). Each cohort serves one
# classification task + OS survival. Roster spans binary mutation, 3-class
# immune subtype, and 3-class tumour grade across two data sources.
# See paper/preprint/EXPERIMENT_GRID.md §1 for the full roster + rationale.
# ============================================================

# TCGA-LUAD — KRAS mutation (binary)
AUTOBENCH_TCGA_LUAD_ROOT=/path/to/tcga_luad
# TCGA-LGG — IDH1 mutation (binary)
AUTOBENCH_TCGA_LGG_ROOT=/path/to/tcga_lgg
# TCGA-HNSC — tumour grade (3-class G1/G2/G3)
AUTOBENCH_TCGA_HNSC_ROOT=/path/to/tcga_hnsc
# CPTAC-GBM — TP53 mutation (binary)
AUTOBENCH_CPTAC_GBM_ROOT=/path/to/cptac_gbm
# CPTAC-PDAC — immune subtype (3-class low/medium/high)
AUTOBENCH_CPTAC_PDAC_ROOT=/path/to/cptac_pdac

# ============================================================
# Additional TCGA catalog (GOLDMARK — journal-phase, not in preprint roster)
# Set these to your cluster paths before running feature extraction.
# See docs/tutorials/tcga_feature_extraction_tutorial.md for setup instructions.
# ============================================================

AUTOBENCH_TCGA_BLCA_ROOT=/path/to/tcga_blca
AUTOBENCH_TCGA_COAD_ROOT=/path/to/tcga_coad
AUTOBENCH_TCGA_SKCM_ROOT=/path/to/tcga_skcm
AUTOBENCH_TCGA_UCEC_ROOT=/path/to/tcga_ucec
AUTOBENCH_TCGA_THCA_ROOT=/path/to/tcga_thca
AUTOBENCH_TCGA_STAD_ROOT=/path/to/tcga_stad
AUTOBENCH_TCGA_TGCT_ROOT=/path/to/tcga_tgct
AUTOBENCH_TCGA_PAAD_ROOT=/path/to/tcga_paad
AUTOBENCH_TCGA_PCPG_ROOT=/path/to/tcga_pcpg
AUTOBENCH_TCGA_UCS_ROOT=/path/to/tcga_ucs

# ============================================================
# Additional CPTAC catalog (Patho-Bench — journal-phase, not in preprint roster)
# See docs/tutorials/cptac_feature_extraction_tutorial.md for setup instructions.
# ============================================================

AUTOBENCH_CPTAC_BRCA_ROOT=/path/to/cptac_brca
AUTOBENCH_CPTAC_CCRCC_ROOT=/path/to/cptac_ccrcc
AUTOBENCH_CPTAC_COAD_ROOT=/path/to/cptac_coad
AUTOBENCH_CPTAC_HNSC_ROOT=/path/to/cptac_hnsc
AUTOBENCH_CPTAC_LSCC_ROOT=/path/to/cptac_lscc
AUTOBENCH_CPTAC_LUAD_ROOT=/path/to/cptac_luad
AUTOBENCH_CPTAC_UCEC_ROOT=/path/to/cptac_ucec
AUTOBENCH_CPTAC_OV_ROOT=/path/to/cptac_ov
